{
  "compilerOptions": {
    "target": "es2022",
    "lib": ["es2023", "dom"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"],
    "paths": {
      "@open-arch/core": ["../../packages/core/src/index.ts"],
      "open-arch/workspace": ["../../packages/cli/src/workspace.ts"]
    }
  },
  "include": ["src"]
}
