{
  "openarch": 17,
  "name": "Shop",
  "description": "An online shop, used as the open-arch example.",
  "export": { "docs": "docs" },
  "elements": {
    "customer": {
      "kind": "person",
      "name": "Customer",
      "description": "Someone buying from the shop.",
      "notes": "Customers use the shop from a browser on desktop or mobile.",
      "uses": [
        { "to": "web-app", "description": "Browses products and places orders", "technology": "HTTPS" }
      ]
    },
    "payment-provider": {
      "kind": "system",
      "name": "Payment Provider",
      "description": "Takes card payments.",
      "external": true,
      "notes": "A third-party card processor."
    },
    "shop": {
      "kind": "system",
      "name": "Shop",
      "description": "Lets customers browse products and place orders.",
      "notes": "The online shop. Owned by the Checkout team."
    },
    "checkout-api": {
      "kind": "container",
      "name": "Checkout API",
      "parent": "shop",
      "description": "Validates carts, reserves stock and takes payment.",
      "technology": "Node.js",
      "libraries": ["logging"],
      "notes": "Its relationships are listed on its components, so container views show them as arrows from the Checkout API."
    },
    "checkout-controller": {
      "kind": "component",
      "name": "Checkout Controller",
      "parent": "checkout-api",
      "description": "Handles checkout requests from the web app.",
      "technology": "Express",
      "uses": [
        { "to": "order-repository", "description": "Saves orders" },
        { "to": "payment-client", "description": "Takes payment" },
        { "to": "warehouse", "description": "Reserves stock", "technology": "gRPC" },
        { "to": "logger", "description": "Logs each request with" }
      ]
    },
    "order-repository": {
      "kind": "component",
      "name": "Order Repository",
      "parent": "checkout-api",
      "description": "Reads and writes orders.",
      "technology": "TypeScript",
      "uses": [
        { "to": "orders-db", "description": "Reads and writes orders", "technology": "SQL" }
      ]
    },
    "order": {
      "kind": "class",
      "name": "Order",
      "parent": "order-repository",
      "stereotype": "entity",
      "members": [
        "+id: OrderId",
        "+customerId: string",
        "+placedAt: Date",
        "+total(): Money"
      ],
      "uses": [
        { "to": "order-line", "kind": "composition", "description": "Lists what was bought in" }
      ]
    },
    "order-line": {
      "kind": "class",
      "name": "OrderLine",
      "parent": "order-repository",
      "members": [
        "+sku: string",
        "+quantity: number",
        "+price: Money"
      ]
    },
    "orders": {
      "kind": "class",
      "name": "Orders",
      "parent": "order-repository",
      "description": "What the rest of the API needs from a store of orders.",
      "stereotype": "interface",
      "members": [
        "+save(order: Order): void",
        "+find(id: OrderId): Order"
      ],
      "uses": [
        { "to": "order", "kind": "dependency", "description": "Saves and finds" }
      ]
    },
    "postgres-orders": {
      "kind": "class",
      "name": "PostgresOrders",
      "parent": "order-repository",
      "description": "Keeps orders in the Orders DB.",
      "members": [
        "-pool: Pool",
        "+save(order: Order): void",
        "+find(id: OrderId): Order"
      ],
      "uses": [
        { "to": "orders", "kind": "realization" }
      ]
    },
    "payment-client": {
      "kind": "component",
      "name": "Payment Client",
      "parent": "checkout-api",
      "description": "Wraps the payment provider's API.",
      "technology": "TypeScript",
      "uses": [
        { "to": "payment-provider", "description": "Charges cards", "technology": "HTTPS", "notes": "Sends the one-time card token the web app got from the provider, never a card number.\n\nEach charge has an idempotency key, so retrying a request can't charge a card twice." }
      ]
    },
    "orders-db": {
      "kind": "container",
      "name": "Orders DB",
      "parent": "shop",
      "description": "Stores orders and their status.",
      "technology": "PostgreSQL",
      "shape": "database"
    },
    "web-app": {
      "kind": "container",
      "name": "Web App",
      "parent": "shop",
      "description": "The storefront customers use.",
      "technology": "React",
      "libraries": ["logging"],
      "notes": "Single-page app served from a CDN.",
      "uses": [
        { "to": "checkout-controller", "description": "Places orders", "technology": "HTTPS/JSON" },
        { "to": "logger", "description": "Logs errors with" }
      ]
    },
    "warehouse": {
      "kind": "system",
      "name": "Warehouse",
      "description": "Tracks stock and ships orders.",
      "notes": "Run by the Fulfilment team. The shop only talks to it to reserve stock."
    },
    "logging": {
      "kind": "library",
      "name": "Logging",
      "description": "Structured logs, written the same way in every part of the shop.",
      "technology": "TypeScript",
      "notes": "Shared by the web app and the Checkout API. Each is built with its own copy, so it's drawn inside each one's component view."
    },
    "json-logger": {
      "kind": "class",
      "name": "JsonLogger",
      "parent": "logging",
      "description": "Writes one JSON line per message.",
      "members": [
        "-service: string",
        "+info(message: string, fields?: Fields): void",
        "+error(message: string, error: Error): void"
      ],
      "uses": [
        { "to": "logger", "kind": "realization" }
      ]
    },
    "logger": {
      "kind": "class",
      "name": "Logger",
      "parent": "logging",
      "stereotype": "interface",
      "members": [
        "+info(message: string, fields?: Fields): void",
        "+error(message: string, error: Error): void"
      ]
    }
  },
  "views": {
    "checking-out": {
      "title": "Checking out",
      "description": "What the Checkout API does when a customer places an order, from the cart to a receipt.",
      "level": "flowchart",
      "scope": "checkout-api",
      "lanes": [
        { "id": "customer", "name": "Customer" },
        { "id": "checkout-api", "name": "Checkout API" },
        { "id": "payment-provider", "name": "Payment Provider" }
      ],
      "blocks": [
        { "id": "checks-out", "kind": "start", "text": "Customer checks out", "lane": "customer" },
        { "id": "total", "text": "Work out the total", "description": "Prices, delivery and tax", "lane": "checkout-api" },
        { "id": "card-details", "kind": "input-output", "text": "Read the card details", "lane": "checkout-api" },
        { "id": "take-payment", "kind": "subprocess", "text": "Take the payment", "description": "With the payment provider", "lane": "payment-provider" },
        { "id": "paid", "kind": "decision", "text": "Payment taken?", "lane": "checkout-api" },
        { "id": "declined", "text": "Say the card was declined", "lane": "checkout-api" },
        { "id": "save-order", "text": "Save the order", "lane": "checkout-api" },
        { "id": "orders", "kind": "database", "text": "Orders DB", "lane": "checkout-api" },
        { "id": "receipt", "kind": "document", "text": "Email a receipt", "lane": "checkout-api" },
        { "id": "placed", "kind": "end", "text": "Order placed", "lane": "customer" }
      ],
      "flows": [
        { "from": "checks-out", "to": "total" },
        { "from": "total", "to": "card-details" },
        { "from": "card-details", "to": "take-payment" },
        { "from": "take-payment", "to": "paid" },
        { "from": "paid", "to": "save-order", "text": "Yes" },
        { "from": "paid", "to": "declined", "text": "No" },
        { "from": "declined", "to": "card-details", "text": "Try another card" },
        { "from": "save-order", "to": "orders" },
        { "from": "save-order", "to": "receipt" },
        { "from": "receipt", "to": "placed" }
      ]
    },
    "checkout-api-components": {
      "title": "Checkout API components",
      "description": "How a checkout request is handled.",
      "level": "component",
      "scope": "checkout-api",
      "include": ["*"],
      "notes": "A request from the web app comes in to the Checkout Controller. It reserves stock and takes payment before it saves the order, so every saved order is paid for."
    },
    "checkout-screens": {
      "title": "Checkout screens",
      "description": "What the customer sees, from a product to a placed order.",
      "level": "wireframe",
      "scope": "web-app",
      "screens": [
        {
          "id": "product",
          "name": "Product",
          "description": "One product, with its price and a button to buy it.",
          "widgets": [
            { "id": "product-nav", "kind": "tabs", "text": "Shoes\nHats\nBags" },
            {
              "id": "product-details",
              "kind": "row",
              "widgets": [
                { "id": "product-photo", "kind": "image", "text": "Photo of the product" },
                {
                  "id": "product-buy",
                  "kind": "panel",
                  "widgets": [
                    { "id": "product-name", "kind": "heading", "text": "Red running shoes" },
                    { "id": "product-price", "kind": "text", "text": "$80, in stock" },
                    { "id": "product-size", "kind": "select", "text": "Size" },
                    { "id": "add-to-cart", "kind": "button", "text": "Add to cart", "description": "Reserves nothing yet: stock is reserved when the order is placed.", "to": "cart" }
                  ]
                }
              ]
            }
          ]
        },
        {
          "id": "cart",
          "name": "Cart",
          "description": "What the customer is about to buy.",
          "widgets": [
            { "id": "cart-title", "kind": "heading", "text": "Your cart" },
            { "id": "cart-items", "kind": "table", "text": "Item | Size | Price\nRed running shoes | 9 | $80\nWool hat | M | $25" },
            { "id": "cart-total", "kind": "text", "text": "Total: $105, with free delivery" },
            {
              "id": "cart-actions",
              "kind": "row",
              "widgets": [
                { "id": "keep-shopping", "kind": "link", "text": "Keep shopping", "to": "product" },
                { "id": "check-out", "kind": "button", "text": "Check out", "to": "payment" }
              ]
            }
          ]
        },
        {
          "id": "payment",
          "name": "Payment",
          "description": "The card details, which go straight to the payment provider.",
          "widgets": [
            { "id": "payment-title", "kind": "heading", "text": "Pay" },
            {
              "id": "card",
              "kind": "panel",
              "text": "Card",
              "widgets": [
                { "id": "card-number", "kind": "input", "text": "Card number", "description": "A field from the payment provider's script, so the card number never reaches the shop." },
                {
                  "id": "card-dates",
                  "kind": "row",
                  "widgets": [
                    { "id": "card-expiry", "kind": "input", "text": "Expiry" },
                    { "id": "card-code", "kind": "input", "text": "Security code" }
                  ]
                }
              ]
            },
            { "id": "save-card", "kind": "checkbox", "text": "Remember this card" },
            { "id": "pay", "kind": "button", "text": "Pay $105", "description": "Places the order: the Checkout API reserves stock, takes payment, then saves it.", "to": "placed" },
            { "id": "back-to-cart", "kind": "link", "text": "Back to the cart", "to": "cart" }
          ]
        },
        {
          "id": "placed",
          "name": "Order placed",
          "description": "Also sent as an email.",
          "device": "phone",
          "widgets": [
            { "id": "placed-title", "kind": "heading", "text": "Thank you!" },
            { "id": "placed-text", "kind": "text", "text": "Your order is on its way. We've emailed you a receipt." },
            { "id": "placed-next", "kind": "list", "text": "Track your order\nChange the delivery address" },
            { "id": "placed-divider", "kind": "divider" },
            { "id": "placed-home", "kind": "link", "text": "Back to the shop", "to": "product" }
          ]
        }
      ]
    },
    "faster-checkout-ideas": {
      "title": "Ideas for a faster checkout",
      "description": "Rough ideas from the checkout retro, to talk through before anything is decided.",
      "level": "whiteboard",
      "shapes": [
        { "id": "title", "kind": "text", "text": "Ideas for a faster checkout", "at": [0, -170], "size": "large" },
        { "id": "underline", "kind": "pen", "at": [8, -118], "points": [[0, 4], [90, 0], [200, 5], [330, 1], [390, 4]], "color": "blue" },
        { "id": "slow", "kind": "rectangle", "text": "Checkout takes 3 s at lunchtime", "at": [0, 0, 200, 90], "fill": "red" },
        { "id": "cache", "kind": "rectangle", "text": "Cache the product pages", "at": [320, -70, 220, 80], "fill": "yellow" },
        { "id": "background", "kind": "rectangle", "text": "Take payment in the background", "at": [320, 90, 220, 80], "fill": "blue", "dashed": true },
        { "id": "where", "kind": "diamond", "text": "Redis, or in memory?", "at": [660, -100, 200, 120] },
        { "id": "orders-db", "kind": "ellipse", "text": "Orders DB", "at": [720, 90, 180, 80], "color": "blue" },
        { "id": "measure", "kind": "text", "text": "Measure it first!", "at": [0, 190], "color": "red" }
      ],
      "arrows": [
        { "id": "idea-1", "from": "slow", "to": "cache", "text": "idea 1" },
        { "id": "idea-2", "from": "slow", "to": "background", "text": "idea 2" },
        { "id": "which", "from": "cache", "to": { "shape": "where", "side": "left" }, "heads": "none", "dashed": true },
        { "id": "saves", "from": "background", "to": "orders-db", "text": "saves it first" },
        { "id": "look", "from": [80, 186], "to": "slow", "color": "red" }
      ],
      "stickies": {
        "nothing-decided": { "text": "Nothing here is decided yet. Once it is, the change goes in the model, and on the container view.", "at": [700, 230] }
      }
    },
    "landscape": {
      "title": "System landscape",
      "description": "Every person and system, and how they connect.",
      "level": "landscape",
      "include": ["*"]
    },
    "logging-classes": {
      "title": "Logging classes",
      "description": "The shared logging code, and what logs with it.",
      "level": "class",
      "scope": "logging",
      "include": ["*"]
    },
    "order-events": {
      "title": "From order to delivery",
      "description": "What happens in the business when a customer orders, as an event storm.",
      "level": "event",
      "lanes": [
        { "id": "customer", "name": "Customer" },
        { "id": "shop", "name": "Shop" },
        { "id": "payment-provider", "name": "Payment Provider" },
        { "id": "warehouse", "name": "Warehouse" }
      ],
      "cards": [
        { "id": "shopper", "kind": "actor", "name": "Customer", "lane": "customer" },
        { "id": "place-order", "kind": "command", "name": "Place order", "lane": "customer", "from": ["shopper"] },
        { "id": "order-placed", "kind": "event", "name": "Order placed", "lane": "shop", "from": ["place-order"] },
        { "id": "pay-when-placed", "kind": "policy", "name": "Whenever an order is placed, take payment", "lane": "shop", "from": ["order-placed"] },
        { "id": "take-payment", "kind": "command", "name": "Take payment", "lane": "payment-provider", "from": ["pay-when-placed"] },
        { "id": "card-declined", "kind": "hotspot", "name": "What if the card is declined?", "lane": "payment-provider" },
        { "id": "payment-taken", "kind": "event", "name": "Payment taken", "lane": "payment-provider", "from": ["take-payment"] },
        { "id": "ship-when-paid", "kind": "policy", "name": "Whenever payment is taken, ship the order", "lane": "shop", "from": ["payment-taken"] },
        { "id": "ship-order", "kind": "command", "name": "Ship order", "lane": "warehouse", "from": ["ship-when-paid"] },
        { "id": "order-shipped", "kind": "event", "name": "Order shipped", "lane": "warehouse", "from": ["ship-order"] },
        { "id": "order-status", "kind": "read-model", "name": "Order status", "description": "Where the order is, with its tracking link.", "lane": "customer", "from": ["payment-taken", "order-shipped"] }
      ]
    },
    "order-repository-classes": {
      "title": "Order Repository classes",
      "description": "The classes that store orders, and how they fit together.",
      "level": "class",
      "scope": "order-repository",
      "include": ["*"],
      "layout": {
        "order": [50, 560],
        "order-line": [50, 800],
        "orders": [50, 300],
        "postgres-orders": [50, 60]
      }
    },
    "order-states": {
      "title": "Order states",
      "description": "What an order goes through, from being placed to being delivered.",
      "level": "state",
      "scope": "order",
      "initial": "placed",
      "states": {
        "cancelled": { "name": "Cancelled", "final": true },
        "delivered": { "name": "Delivered", "final": true },
        "paid": { "name": "Paid", "description": "The card was charged, and the stock reserved." },
        "placed": { "name": "Placed", "description": "Waiting for payment." },
        "refunded": { "name": "Refunded", "final": true },
        "shipped": { "name": "Shipped", "description": "On its way to the customer." }
      },
      "transitions": [
        { "from": "placed", "to": "paid", "event": "Payment taken", "guard": "paid in full", "action": "Reserve the stock" },
        { "from": "placed", "to": "placed", "event": "Payment fails", "action": "Ask for another card" },
        { "from": "placed", "to": "cancelled", "event": "Customer cancels" },
        { "from": "paid", "to": "shipped", "event": "Warehouse ships it", "action": "Email the tracking link" },
        { "from": "paid", "to": "refunded", "event": "Customer cancels", "action": "Refund the card" },
        { "from": "shipped", "to": "delivered", "event": "Courier delivers it" }
      ]
    },
    "place-order": {
      "title": "Placing an order",
      "description": "What happens, in order, when a customer places an order.",
      "level": "sequence",
      "notes": "Stock is reserved and the card is charged before the order is saved, so every saved order is paid for.",
      "steps": [
        { "from": "customer", "to": "web-app", "description": "Places an order" },
        { "from": "web-app", "to": "checkout-controller", "description": "Sends the cart and the card token" },
        { "from": "checkout-controller", "to": "warehouse" },
        { "from": "checkout-controller", "to": "payment-client" },
        { "from": "payment-client", "to": "payment-provider" },
        { "from": "payment-provider", "to": "payment-client", "description": "Payment confirmed", "reply": true },
        { "from": "checkout-controller", "to": "order-repository" },
        { "from": "order-repository", "to": "orders-db", "description": "Inserts the order" },
        { "from": "checkout-controller", "to": "web-app", "description": "Order number", "reply": true },
        { "from": "web-app", "to": "customer", "description": "Shows the confirmation", "reply": true }
      ]
    },
    "production": {
      "title": "Production",
      "description": "Where the shop runs for customers.",
      "level": "deployment",
      "nodes": {
        "aws": { "name": "Amazon Web Services", "technology": "AWS" },
        "eu-west-1": { "name": "EU (Ireland)", "parent": "aws", "technology": "eu-west-1" },
        "api-servers": { "name": "API servers", "parent": "eu-west-1", "technology": "Amazon ECS on Fargate", "instances": 3, "runs": ["checkout-api"] },
        "database": { "name": "Database", "parent": "eu-west-1", "technology": "Amazon RDS for PostgreSQL", "runs": ["orders-db"] },
        "load-balancer": { "name": "Load balancer", "parent": "eu-west-1", "technology": "Application Load Balancer", "infrastructure": true },
        "customer-computer": { "name": "Customer's computer", "technology": "A web browser", "runs": ["web-app"] },
        "payment-cloud": { "name": "Payment provider's cloud", "runs": ["payment-provider"] },
        "warehouse-data-centre": { "name": "Warehouse data centre", "technology": "On premises", "runs": ["warehouse"] }
      },
      "connections": [
        { "from": "load-balancer", "to": "checkout-api", "description": "Forwards requests to", "technology": "HTTPS" },
        { "from": "web-app", "to": "load-balancer", "description": "Sends API calls to", "technology": "HTTPS" }
      ]
    },
    "shop-containers": {
      "title": "Shop containers",
      "description": "What runs inside the shop.",
      "level": "container",
      "scope": "shop",
      "include": ["*"],
      "layout": {
        "checkout-api": [0, 320],
        "customer": [0, 0],
        "orders-db": [0, 480],
        "web-app": [0, 160]
      }
    },
    "shop-context": {
      "title": "Shop context",
      "description": "Who uses the shop, and which systems it depends on.",
      "level": "context",
      "scope": "shop",
      "include": ["*"]
    }
  }
}
