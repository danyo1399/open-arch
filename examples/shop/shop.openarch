{
  "openarch": 7,
  "name": "Shop",
  "description": "An online shop, used as the open-arch example.",
  "export": { "docs": "docs" },
  "elements": {
    "customer": {
      "kind": "person",
      "name": "Customer",
      "description": "Someone buying from the shop.",
      "notes": "Customers use the shop from a browser on desktop or mobile.",
      "uses": [
        { "to": "web-app", "description": "Browses products and places orders", "technology": "HTTPS" }
      ]
    },
    "payment-provider": {
      "kind": "system",
      "name": "Payment Provider",
      "description": "Takes card payments.",
      "external": true,
      "notes": "A third-party card processor."
    },
    "shop": {
      "kind": "system",
      "name": "Shop",
      "description": "Lets customers browse products and place orders.",
      "notes": "The online shop. Owned by the Checkout team."
    },
    "checkout-api": {
      "kind": "container",
      "name": "Checkout API",
      "parent": "shop",
      "description": "Validates carts, reserves stock and takes payment.",
      "technology": "Node.js",
      "libraries": ["logging"],
      "notes": "Its relationships are listed on its components, so container views show them as arrows from the Checkout API."
    },
    "checkout-controller": {
      "kind": "component",
      "name": "Checkout Controller",
      "parent": "checkout-api",
      "description": "Handles checkout requests from the web app.",
      "technology": "Express",
      "uses": [
        { "to": "order-repository", "description": "Saves orders" },
        { "to": "payment-client", "description": "Takes payment" },
        { "to": "warehouse", "description": "Reserves stock", "technology": "gRPC" },
        { "to": "logger", "description": "Logs each request with" }
      ]
    },
    "order-repository": {
      "kind": "component",
      "name": "Order Repository",
      "parent": "checkout-api",
      "description": "Reads and writes orders.",
      "technology": "TypeScript",
      "uses": [
        { "to": "orders-db", "description": "Reads and writes orders", "technology": "SQL" }
      ]
    },
    "order": {
      "kind": "class",
      "name": "Order",
      "parent": "order-repository",
      "stereotype": "entity",
      "members": [
        "+id: OrderId",
        "+customerId: string",
        "+placedAt: Date",
        "+total(): Money"
      ],
      "uses": [
        { "to": "order-line", "kind": "composition", "description": "Lists what was bought in" }
      ]
    },
    "order-line": {
      "kind": "class",
      "name": "OrderLine",
      "parent": "order-repository",
      "members": [
        "+sku: string",
        "+quantity: number",
        "+price: Money"
      ]
    },
    "orders": {
      "kind": "class",
      "name": "Orders",
      "parent": "order-repository",
      "description": "What the rest of the API needs from a store of orders.",
      "stereotype": "interface",
      "members": [
        "+save(order: Order): void",
        "+find(id: OrderId): Order"
      ],
      "uses": [
        { "to": "order", "kind": "dependency", "description": "Saves and finds" }
      ]
    },
    "postgres-orders": {
      "kind": "class",
      "name": "PostgresOrders",
      "parent": "order-repository",
      "description": "Keeps orders in the Orders DB.",
      "members": [
        "-pool: Pool",
        "+save(order: Order): void",
        "+find(id: OrderId): Order"
      ],
      "uses": [
        { "to": "orders", "kind": "realization" }
      ]
    },
    "payment-client": {
      "kind": "component",
      "name": "Payment Client",
      "parent": "checkout-api",
      "description": "Wraps the payment provider's API.",
      "technology": "TypeScript",
      "uses": [
        { "to": "payment-provider", "description": "Charges cards", "technology": "HTTPS", "notes": "Sends the one-time card token the web app got from the provider, never a card number.\n\nEach charge has an idempotency key, so retrying a request can't charge a card twice." }
      ]
    },
    "orders-db": {
      "kind": "container",
      "name": "Orders DB",
      "parent": "shop",
      "description": "Stores orders and their status.",
      "technology": "PostgreSQL",
      "shape": "database"
    },
    "web-app": {
      "kind": "container",
      "name": "Web App",
      "parent": "shop",
      "description": "The storefront customers use.",
      "technology": "React",
      "libraries": ["logging"],
      "notes": "Single-page app served from a CDN.",
      "uses": [
        { "to": "checkout-controller", "description": "Places orders", "technology": "HTTPS/JSON" },
        { "to": "logger", "description": "Logs errors with" }
      ]
    },
    "warehouse": {
      "kind": "system",
      "name": "Warehouse",
      "description": "Tracks stock and ships orders.",
      "notes": "Run by the Fulfilment team. The shop only talks to it to reserve stock."
    },
    "logging": {
      "kind": "library",
      "name": "Logging",
      "description": "Structured logs, written the same way in every part of the shop.",
      "technology": "TypeScript",
      "notes": "Shared by the web app and the Checkout API. Each is built with its own copy, so it's drawn inside each one's component view."
    },
    "json-logger": {
      "kind": "class",
      "name": "JsonLogger",
      "parent": "logging",
      "description": "Writes one JSON line per message.",
      "members": [
        "-service: string",
        "+info(message: string, fields?: Fields): void",
        "+error(message: string, error: Error): void"
      ],
      "uses": [
        { "to": "logger", "kind": "realization" }
      ]
    },
    "logger": {
      "kind": "class",
      "name": "Logger",
      "parent": "logging",
      "stereotype": "interface",
      "members": [
        "+info(message: string, fields?: Fields): void",
        "+error(message: string, error: Error): void"
      ]
    }
  },
  "views": {
    "checkout-api-components": {
      "title": "Checkout API components",
      "description": "How a checkout request is handled.",
      "level": "component",
      "scope": "checkout-api",
      "include": ["*"],
      "notes": "A request from the web app comes in to the Checkout Controller. It reserves stock and takes payment before it saves the order, so every saved order is paid for."
    },
    "landscape": {
      "title": "System landscape",
      "description": "Every person and system, and how they connect.",
      "level": "landscape",
      "include": ["*"]
    },
    "logging-classes": {
      "title": "Logging classes",
      "description": "The shared logging code, and what logs with it.",
      "level": "class",
      "scope": "logging",
      "include": ["*"]
    },
    "order-repository-classes": {
      "title": "Order Repository classes",
      "description": "The classes that store orders, and how they fit together.",
      "level": "class",
      "scope": "order-repository",
      "include": ["*"],
      "layout": {
        "order": [50, 560],
        "order-line": [50, 800],
        "orders": [50, 300],
        "postgres-orders": [50, 60]
      }
    },
    "place-order": {
      "title": "Placing an order",
      "description": "What happens, in order, when a customer places an order.",
      "level": "sequence",
      "notes": "Stock is reserved and the card is charged before the order is saved, so every saved order is paid for.",
      "steps": [
        { "from": "customer", "to": "web-app", "description": "Places an order" },
        { "from": "web-app", "to": "checkout-controller", "description": "Sends the cart and the card token" },
        { "from": "checkout-controller", "to": "warehouse" },
        { "from": "checkout-controller", "to": "payment-client" },
        { "from": "payment-client", "to": "payment-provider" },
        { "from": "payment-provider", "to": "payment-client", "description": "Payment confirmed", "reply": true },
        { "from": "checkout-controller", "to": "order-repository" },
        { "from": "order-repository", "to": "orders-db", "description": "Inserts the order" },
        { "from": "checkout-controller", "to": "web-app", "description": "Order number", "reply": true },
        { "from": "web-app", "to": "customer", "description": "Shows the confirmation", "reply": true }
      ]
    },
    "shop-containers": {
      "title": "Shop containers",
      "description": "What runs inside the shop.",
      "level": "container",
      "scope": "shop",
      "include": ["*"],
      "layout": {
        "checkout-api": [0, 320],
        "customer": [0, 0],
        "orders-db": [0, 480],
        "web-app": [0, 160]
      }
    },
    "shop-context": {
      "title": "Shop context",
      "description": "Who uses the shop, and which systems it depends on.",
      "level": "context",
      "scope": "shop",
      "include": ["*"]
    }
  }
}
