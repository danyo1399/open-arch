{
  "name": "open-arch-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.25.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -b packages/core packages/cli apps/server",
    "clean": "node scripts/clean.mjs",
    "test": "vitest run",
    "open-arch": "node packages/cli/dist/bin.js",
    "typecheck": "tsc -b packages/core packages/cli apps/server && tsc -p apps/web && tsc -p apps/desktop",
    "verify": "node scripts/verify.mjs",
    "land": "node scripts/land.mjs",
    "prepare": "node scripts/setup-hooks.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
