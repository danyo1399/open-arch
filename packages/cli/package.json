{
  "name": "open-arch",
  "version": "0.1.0",
  "description": "Command line tool for open-arch workspaces: read, check and export a .openarch architecture model, and change it with validated commands.",
  "type": "module",
  "bin": {
    "open-arch": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/main.d.ts",
      "default": "./dist/main.js"
    },
    "./workspace": {
      "types": "./dist/workspace.d.ts",
      "default": "./dist/workspace.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@open-arch/core": "workspace:*",
    "@open-arch/skill": "workspace:*"
  }
}
